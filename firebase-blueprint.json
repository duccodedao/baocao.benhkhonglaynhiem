      "required": ["id", "code", "name"]
    },
    "unitConfig": {
      "title": "Unit Configuration",
      "description": "Cấu hình tên Trạm Y tế, Quận/Huyện, Tỉnh/Thành",
      "properties": {
        "unitName": { "type": "string" },
        "districtName": { "type": "string" },
        "provinceName": { "type": "string" },
