        "uid": { "type": "string", "description": "User ID" },
        "email": { "type": "string", "description": "Email Google" },
        "displayName": { "type": "string", "description": "Họ tên người dùng" },
        "role": { "type": "string", "description": "ADMIN | STAFF | VIEWER" },
        "unitName": { "type": "string", "description": "Đơn vị công tác" },
        "active": { "type": "boolean", "description": "Trạng thái kích hoạt" },
        "createdAt": { "type": "string", "description": "Ngày tạo" }
      },
      "required": ["email", "displayName", "role"]
    },
    "reports": {
      "title": "Monthly Disease Reports",
      "description": "Báo cáo tháng số liệu bệnh không lây nhiễm",
      "properties": {
        "id": { "type": "string" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "details": { "type": "array" },
        "isLocked": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["month", "year", "details"]
    },
    "diseases": {
      "title": "Disease Catalog",
      "description": "Danh mục các nhóm bệnh mạn tính",
