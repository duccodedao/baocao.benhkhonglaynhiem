    "auditLogs": {
      "title": "Audit Logs",
      "description": "Nhật ký hoạt động thao tác hệ thống",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "description": { "type": "string" }
      }
